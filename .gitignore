# --- Python ---
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
.eggs/
build/
dist/

# --- Virtual environments ---
.env/
luna/
env/

# --- Environment / secrets ---
.env
.env.*
*service-account*.json
*credentials*.json
gcloud-key*.json

# --- Data (raw/processed data shouldn't live in git — regenerate via ETL scripts) ---
data/raw/*
data/processed/*
!data/raw/.gitkeep
!data/processed/.gitkeep
*.tif
*.tiff
*.shp
*.shx
*.dbf
*.prj

# --- Jupyter ---
.ipynb_checkpoints/
*.ipynb_checkpoints

# --- Streamlit ---
.streamlit/secrets.toml

# --- OS / editor ---
.DS_Store
Thumbs.db
.vscode/
.idea/

# --- Logs ---
*.log